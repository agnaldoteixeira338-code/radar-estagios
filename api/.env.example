# Copie este arquivo para .env e preencha com os seus valores reais.
# O .env NUNCA deve ir para o GitHub (já está no .gitignore).

PORT=4000

# String de conexão do seu projeto no Neon (PostgreSQL na nuvem)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Segredo que assina os tokens de login (mínimo 32 caracteres, aleatório).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
