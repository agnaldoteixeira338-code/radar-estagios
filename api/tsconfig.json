{
  // Configuração usada pelo editor (VS Code), pelos testes (ts-jest) e pelo "npm run typecheck".
  // Inclui src, tests e scripts para que o editor reconheça todos os arquivos (e describe/it/expect nos testes).
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "tests", "scripts"]
}
